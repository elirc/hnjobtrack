+class ParsedListing(BaseModel):
+    """The contract between the LLM and our schema. Anything that fails it is flagged, never written."""
+
+    company: Optional[str] = None
+    role: Optional[str] = None
+    role_type: Optional[RoleType] = None
+    location: list[str] = []
+    remote: Optional[RemoteType] = None
+    visa_sponsorship: Optional[bool] = None
+    salary_min: Optional[int] = None
+    salary_max: Optional[int] = None
+    salary_currency: Optional[str] = None
+    skills: list[str] = []
+    description: Optional[str] = None
+    apply_url: Optional[str] = None
+    apply_email: Optional[str] = None
+    equity: Optional[bool] = None
+    parse_confidence: Optional[float] = None
+
+    @field_validator("role_type", mode="before")
+    @classmethod
+    def first_valid_role_type(cls, v):
+        # Models drift toward "full-time, contract" even when told not to: keep the first valid value.
+        if isinstance(v, str) and "," in v:
+            for part in (p.strip().lower() for p in v.split(",")):
+                if part in {t.value for t in RoleType}:
+                    return part
+            return None
+        return v
+
+    @field_validator("location", "skills", mode="before")
+    @classmethod
+    def none_to_empty(cls, v):
+        return v or []
+
