@@ -18,12 +18,14 @@ def _decode_supabase_jwt(token: str) -> AuthUser:
     /auth/v1/user (sb.auth.get_user), which was ~60% of p95 on /jobs/for-you.
     The access token already carries everything we need (sub, email).
     """
+    # Fail closed: never decode without verifying. Signature, exp and aud are all checked;
+    # the secret is a required setting, so a missing env var stops the app at boot instead.
     claims = jwt.decode(
         token,
-        settings.supabase_jwt_secret or None,
+        settings.supabase_jwt_secret,
         algorithms=["HS256"],
         audience="authenticated",
-        options={"verify_signature": bool(settings.supabase_jwt_secret)},
+        options={"require": ["exp", "sub", "aud"]},
     )
     return AuthUser(id=claims["sub"], email=claims.get("email", ""))
 
