diff --git a/backend/app/core/supabase.py b/backend/app/core/supabase.py
index e07b707..b9ab647 100644
--- a/backend/app/core/supabase.py
+++ b/backend/app/core/supabase.py
@@ -1,3 +1,4 @@
+from postgrest import SyncPostgrestClient
 from supabase import create_client, Client
 from app.core.config import settings
 
@@ -18,12 +19,15 @@ def get_supabase_public() -> Client:
     return supabase_public
 
 
-def get_supabase_as_user(access_token: str) -> Client:
+def get_supabase_as_user(access_token: str) -> SyncPostgrestClient:
     """Anon-key client that sends the caller's JWT, so PostgREST applies RLS as that user.
 
     Use this for user-owned tables (saved_jobs, user_preferences, profiles): even if a
     handler forgets a user_id filter, Postgres only returns the caller's rows.
     """
-    client = get_supabase_public()
-    client.postgrest.auth(access_token)
-    return client
+    # A NEW client per request: auth() mutates the client's session headers, so a shared
+    # client would send whichever user's token was set last (cross-user data leak).
+    return SyncPostgrestClient(
+        f"{settings.supabase_url}/rest/v1",
+        headers={"apikey": settings.supabase_anon_key, "Authorization": f"Bearer {access_token}"},
+    )
